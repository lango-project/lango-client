import js "@lango-project/lango-ui" as ui

export buildTable()

buildTable()
    context log
    context screen
    log.info("Table example handler invoked")
    assert is_bool(log.verbose?)
    if log.verbose?
        log.debug("Table example: narrow=${screen.narrow?}")
    table = new ui/Table("example")
    table.addCol({
        name: "givenName"
        width: 20
        caption: "Given name"
    })
    table.addCol({
        name: "familyName"
        width: 30
        caption: "Family name"
    })
    table.valueMode = "rows"
    template = new ui/TableRowTemplate()
    field = new ui/Input("editor")
    field.label = "Table given name"
    template.addCell().add(field)
    template.addCell().add(new ui/Input("editor"))
    table.rowTemplate = template
    ui/setValue("example", [{
        givenName: "Savas"
        familyName: "Alparslan"
    }])
    return table
