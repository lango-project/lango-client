import "../table_scope"
    class TableScope
import js "node:assert/strict" as check
import js global Promise
import js global Object
import "../app"
    class App
import "../form"
    class Form

class Removing(form, released)
    methods
        getValue()
        dispose()

Removing(form, released)
    @form = form
    @released = released

Removing:getValue()
    return null

Removing:dispose()
    @released.add(@this)
    @form.unregister(@this)
    return null

test "self-unregistering controls cannot skip sibling cleanup"
    app = new App({}, {})
    form = new Form(app)
    released = []
    form.register("first", new Removing(form, released))
    form.register("second", new Removing(form, released))
    form.dispose()
    assert released.length == 2
    assert form.owned.length == 0

test "presentation scopes preserve explicit inherited reads and writes"
    app = new App({}, {})
    root = new Form(app)
    root.register("name", value("Root"))
    presentation = new Form(app, root)
    presentation.inheritThrough = true
    child = new Form(app, presentation)
    child.inheritedNames = ["name"]
    child.register("own", value(1))
    result = child.getValue()
    assert result.name == "Root"
    child.setValue({
        name: "Changed"
    })
    assert root.find("name").getValue() == "Changed"
    failed = false
    try
        presentation.find("name")
    catch error
        failed = true
    assert failed

test "nested values preserve null and inherited values write through"
    app = new App({}, {})
    root = new Form(app)
    root.register("name", value("Alice"))
    root.register("save", value(null))
    child = new Form(app, root)
    child.inheritedNames = ["name"]
    child.register("age", value(0))
    root.register("child", child)
    check/deepStrictEqual(from_json(to_json(root.getValue())), {
        name: "Alice"
        save: null
        child: {
            age: 0
            name: "Alice"
        }
    })
    child.setValue({
        name: "Bob"
    })
    assert root.find("name").getValue() == "Bob"
    assert root.find("child/age").getValue() == 0

test "application listeners outlive form content resources and close on app disposal"
    released = []
    frame = ()
        capture released
        released.add("frame")
    globalListener = ()
        capture released
        released.add("app")
    app = new App({}, {})
    form = new Form(app)
    app.root = form
    form.resources.add(frame)
    app.resources.add(globalListener)
    form.clearResources()
    assert released.length == 1
    assert released[0] == "frame"
    app.dispose()
    assert released.length == 2
    assert released[1] == "app"

test "opaque tokens persist unchanged and storage failure does not break requests"
    saved = []
    store = (key, token)
        capture saved
        saved.add(token)
    app = new App({
        storage: {
            setItem: store
        }
    }, {})
    form = new Form(app)
    form.setToken("opaque-not-a-jwt")
    assert form.token == "opaque-not-a-jwt"
    assert saved[0] == form.token
    broken = new App({}, {})
    other = new Form(broken)
    other.setToken("still-works")

test "parent and child requests serialize while unrelated forms run concurrently"
    calls = []
    app = application(calls)
    root = new Form(app)
    child = new Form(app, root)
    sibling = new Form(app)
    first = root.send("/first")
    second = child.send("/second")
    third = sibling.send("/third")
    return chain Promise/resolve(null)
      then(ignored)
        capture calls
        capture first
        capture third
        assert calls.length == 2
        assert calls[0].url == "/first"
        assert calls[1].url == "/third"
        calls[0].resolve(reply("first-token"))
        calls[1].resolve(reply("third-token"))
        return Promise/all([first, third])
      then(ignored)
        capture calls
        capture second
        assert calls.length == 3
        assert calls[2].url == "/second"
        calls[2].resolve(reply("second-token"))
        return second
      then(ignored)
        capture root
        capture child
        capture sibling
        assert root.token == "first-token"
        assert child.token == "second-token"
        assert sibling.token == "third-token"

test "failed sends are not retried and do not block queued requests"
    calls = []
    app = application(calls)
    form = new Form(app)
    first = chain form.send("/fail")
      catch(error)
        return "failed"
    second = form.send("/next")
    return chain Promise/resolve(null)
      then(ignored)
        capture calls
        capture first
        assert calls.length == 1
        calls[0].resolve({
            ok: false
            status: 500
        })
        return first
      then(result)
        assert result == "failed"
        return Promise/resolve(null)
      then(ignored)
        capture calls
        capture second
        assert calls.length == 2
        calls[1].resolve(reply(null))
        return second

test "view and commands observe the response token first"
    seen = []
    store = (key, token)
        capture seen
        seen.add(token)
    show = (form, view)
        capture seen
        seen.add(form.token)
    app = new App({
        storage: {
            setItem: store
        }
    }, {
        show: show
    })
    form = new Form(app)
    input = value("before")
    form.register("input", input)
    form.handle({
        token: "fresh"
        body: {
            view: {}
            cmds: [{
                type: "values"
                values: {
                    input: "after"
                }
            }]
        }
    })
    assert seen[0] == "fresh"
    assert seen[1] == "fresh"
    assert input.getValue() == "after"

value(initial)
    state = {
        value: initial
    }
    get = ()
        capture state
        return state.value
    set = (next)
        capture state
        state.value = next
        return state.value
    return {
        getValue: get
        setValue: set
        dispose: nothing
    }

application(calls)
    fetch = (url, options)
        pending = new Promise((resolve)
            capture calls
            capture url
            capture options
            calls.add({
                url: url
                options: options
                resolve: resolve
            })
        )
        return pending
    return new App({
        location: {
            href: "http://localhost/"
            origin: "http://localhost"
        }
        storage: {
            setItem: discard
        }
        fetch: fetch
    }, {
        waiting: discard
    })

reply(token)
    get = (name)
        capture token
        return token
    return {
        ok: true
        headers: {
            get: get
        }
        json: emptyReply
    }

emptyReply()
    return Promise/resolve({})

nothing()
    return null

discard(first, second)
    return null

test "form sends wait for asynchronous values before collecting their payload"
    ready = Promise/withResolvers()
    started = Promise/withResolvers()
    state = {
        value: "before"
        calls: 0
    }
    prepare = ()
        capture ready
        return ready.promise
    get = ()
        capture state
        return state.value
    fetch = (url, options)
        capture state
        capture started
        state.calls = state.calls + 1
        started.resolve(options)
        return Promise/resolve(reply("prepared-token"))
    app = new App({
        location: {
            href: "http://localhost/"
            origin: "http://localhost"
        }
        fetch: fetch
    }, {
        waiting: discard
    })
    form = new Form(app)
    form.register("upload", {
        prepareValue: prepare
        getValue: get
        dispose: nothing
    })
    sent = form.send("/prepared")
    return chain Promise/resolve(null)
      then(ignored)
        capture state
        capture ready
        capture started
        assert state.calls == 0
        state.value = "after"
        ready.resolve(null)
        return started.promise
      then(options)
        capture state
        capture sent
        assert from_json(options.body).upload == "after"
        assert state.calls == 1
        return sent


startupFailure(status)
    state = {
        token: "obsolete-token"
        calls: 0
        removed: 0
    }
    read = (key)
        capture state
        return state.token
    remove = (key)
        capture state
        Object/assign(state, {
            token: null
            removed: state.removed + 1
        })
    fetch = (url, options)
        capture state
        capture status
        state.calls = state.calls + 1
        return Promise/resolve({
            ok: false
            status: status
        })
    app = new App({
        storage: {
            getItem: read
            removeItem: remove
        }
        location: {
            href: "http://localhost/"
            origin: "http://localhost"
        }
        fetch: fetch
    }, {})
    return {
        app: app
        state: state
    }

test "startup clears a rejected saved token once and waits for an explicit reload"
    fixture = startupFailure(401)
    return chain fixture.app.start()
      then(ignored)
        throw "Unexpected startup success"
      catch(error)
        capture fixture
        assert error.message.includes("Reload the page")
        assert fixture.state.token == null
        assert fixture.state.removed == 1
        assert fixture.state.calls == 1
        assert fixture.app.root == null

test "startup preserves saved tokens on other failures and ordinary requests never clear them"
    unavailable = startupFailure(503)
    return chain unavailable.app.start()
      then(ignored)
        throw "Unexpected startup success"
      catch(error)
        capture unavailable
        assert error == "HTTP 503"
        assert unavailable.state.token == "obsolete-token"
        assert unavailable.state.removed == 0
        assert unavailable.state.calls == 1
        ordinary = startupFailure(401)
        return chain ordinary.app.post("/protected", {}, "obsolete-token")
          then(ignored)
            throw "Unexpected request success"
          catch(error)
            capture ordinary
            assert error == "HTTP 401"
            assert ordinary.state.token == "obsolete-token"
            assert ordinary.state.removed == 0
            assert ordinary.state.calls == 1


test "table scopes follow renewed tokens without creating forms"
    app = new App({}, {})
    form = new Form(app)
    form.token = "before"
    scope = new TableScope(form)
    cell = new TableScope(scope)
    cell.register("field", value(3))
    assert cell.requestForm == form
    assert cell.token == "before"
    form.token = "after"
    assert cell.token == "after"
    assert app.forms.length == 1
    assert cell.getValue().field == 3
    cell.dispose()
    assert app.forms.length == 1
    assert Object/keys(cell.controls).length == 0


test "table scope errors report through the containing request form"
    shown = []
    report = (form, problem)
        capture shown
        shown.add(form)
    app = new App({}, {
        reportError: report
    })
    form = new Form(app)
    scope = new TableScope(form)
    app.error(scope, "Example")
    assert shown.length == 1
    assert shown[0] == form
