import js "node:fs" as fs
import js "node:path" as path
import js "node:child_process" as children
import js "playwright" as playwright
import js global process
import js global Promise
import js global Object
import js global Number
import js global RegExp
import js global fetch
import js global setTimeout
import js global clearTimeout

npm(directory, args)
    command = [process.env.npm_execpath]
    for args as arg
        command.add(arg)
    return children/execFileSync(process.execPath, command, {
        cwd: directory
        encoding: "utf8"
        timeout: 120000
        maxBuffer: 10485760
        stdio: ["ignore", "pipe", "pipe"]
    })

pack(directory, target)
    packed = from_json(npm(directory, ["pack", "--ignore-scripts", "--json", "--pack-destination", target]))
    return path/join(target, packed[0].filename)

node(args, cwd)
    return children/execFileSync(process.execPath, args, {
        cwd: cwd
        encoding: "utf8"
        timeout: 60000
        stdio: ["ignore", "pipe", "pipe"]
    })

setup()
    root = process.cwd()
    ui = process.env.LANGO_STARTER_UI
    server = process.env.LANGO_STARTER_SERVER
    compiler = process.env.LANGO_STARTER_COMPILER
    if ui == null
        ui = path/resolve("../lango-ui")
    if server == null
        server = path/resolve("../lango-server")
    if compiler == null
        compiler = path/resolve("../lango-js")
    npm(ui, ["run", "build"])
    npm(server, ["run", "build"])
    fs/mkdirSync(".test-output", {
        recursive: true
    })
    dir = fs/mkdtempSync(path/resolve(".test-output/delivery-"))
    uiArchive = pack(ui, dir)
    serverArchive = pack(server, dir)
    compilerArchive = pack(compiler, dir)
    clientArchive = pack(root, dir)
    seed = path/join(dir, "seed")
    fs/mkdirSync(seed)
    fs/writeFileSync(path/join(seed, "package.json"), to_json({
        name: "lango-generator-test"
        private: true
    }))
    npm(seed, ["install", "--offline", "--ignore-scripts", "--no-audit", "--no-fund", uiArchive])
    assert !fs/existsSync(path/join(seed, "node_modules/@lango-project/lango-js"))
    app = path/join(dir, "app")
    creator = path/join(seed, "node_modules/@lango-project/lango-ui/cli/create.mjs")
    node([creator, app, "--name", "@lango-test/generated-ui"], seed)
    assert fs/existsSync(path/join(app, ".gitignore"))
    assert !fs/existsSync(path/join(app, "gitignore"))
    npm(app, ["install", "--offline", "--ignore-scripts", "--no-audit", "--no-fund", "--include=dev", uiArchive, serverArchive, clientArchive, compilerArchive])
    npm(app, ["test"])
    npm(app, ["run", "build"])
    key = fs/readFileSync(path/join(app, ".lango/keys.json"), "utf8")
    npm(app, ["run", "build"])
    assert key == fs/readFileSync(path/join(app, ".lango/keys.json"), "utf8")
    assert fs/existsSync(path/join(app, ".lango/public/.lango/runtime.mjs"))
    assert fs/existsSync(path/join(app, ".lango/public/vendor/flatpickr.mjs"))
    npm(app, ["prune", "--omit=dev", "--offline", "--ignore-scripts", "--no-audit", "--no-fund"])
    assert !fs/existsSync(path/join(app, "node_modules/@lango-project/lango-js"))
    config = path/join(app, "deploy.xml")
    xml = fs/readFileSync(config, "utf8").replace('port="3000"', 'port="0"')
    fs/writeFileSync(config, xml)
    return {
        dir: dir
        app: app
    }

launch(app)
    file = path/join(app, "node_modules/@lango-project/lango-server/dist/cli/server.mjs")
    child = children/spawn(process.execPath, [file, app], {
        cwd: app
        stdio: ["ignore", "pipe", "pipe"]
    })
    ready = Promise/withResolvers()
    exited = Promise/withResolvers()
    state = {
        child: child
        text: ""
        error: ""
        port: null
        exited: exited.promise
    }
    child.stdout.on("data", (chunk)
        capture state
        capture ready
        state.text = "${state.text}${chunk}"
        pattern = new RegExp("Listening on [^:]+:([0-9]+)")
        match = pattern.exec(state.text)
        if match != null and state.port == null
            state.port = Number/parseInt(match[1], 10)
            ready.resolve(state)
    )
    child.stderr.on("data", (chunk)
        capture state
        state.error = "${state.error}${chunk}"
    )
    child.once("error", (error)
        capture ready
        ready.reject(error)
    )
    child.once("exit", (code)
        capture exited
        capture ready
        capture state
        if state.port == null
            ready.reject("Generated app failed to start: ${state.error}")
        exited.resolve(code)
    )
    expire = ()
        capture child
        capture ready
        child.kill("SIGKILL")
        ready.reject("Generated app startup timed out")
    timer = setTimeout(expire, 10000)
    return chain ready.promise
      finally
        capture timer
        clearTimeout(timer)

stop(server)
    if server == null
        return null
    server.child.kill("SIGTERM")
    return server.exited

test "packed generator creates a compiler-free running UI app with real browser deep links"
    files = setup()
    state = {}
    return chain launch(files.app)
      then(server)
        capture state
        Object/assign(state, {
            server: server
            origin: "http://127.0.0.1:${server.port}"
        })
        return fetch("${state.origin}/profile", {
            headers: {
                Accept: "text/html"
            }
        })
      then(res)
        assert res.status == 200
        assert res.headers.get("x-lango-token") == null
        return res.text()
      then(html)
        capture state
        assert html.includes("boot.mjs")
        assert !html.includes("Hello,")
        return fetch("${state.origin}/missing.js", {
            headers: {
                Accept: "text/html"
            }
        })
      then(res)
        capture playwright
        assert res.status == 404
        return playwright/chromium/launch({
            headless: true
        })
      then(browser)
        capture state
        Object/assign(state, {
            browser: browser
        })
        return browser.newPage()
      then(page)
        capture state
        Object/assign(state, {
            page: page
        })
        page.setDefaultTimeout(15000)
        return page.goto("${state.origin}/profile")
      then(ignored)
        capture state
        return state.page.getByRole("button", {
            name: "Greet"
        }).click()
      then(ignored)
        capture state
        return state.page.getByText("Name is required", {
            exact: true
        }).waitFor()
      then(ignored)
        capture state
        return state.page.getByLabel("Name", {
            exact: true
        }).fill(" Ada ")
      then(ignored)
        capture state
        return state.page.getByRole("button", {
            name: "Greet"
        }).click()
      then(ignored)
        capture state
        return state.page.getByText("Hello, Ada!", {
            exact: true
        }).waitFor()
      then(ignored)
        capture state
        return state.page.getByLabel("Name", {
            exact: true
        }).inputValue()
      then(value)
        capture state
        assert value == "Ada"
        return state.page.reload()
      then(ignored)
        capture state
        return state.page.getByText("Enter your name to begin.", {
            exact: true
        }).waitFor()
      then(ignored)
        capture state
        return state.browser.newPage()
      then(tab)
        capture state
        return chain tab.goto("${state.origin}/profile")
          then(ignored)
            capture tab
            return tab.getByRole("button", {
                name: "Greet"
            }).waitFor()
      catch(error)
        capture state
        if state.server != null
            println("Generated server stderr: ${state.server.error}")
        throw error
      finally
        capture state
        if state.browser != null
            return state.browser.close()
      finally
        capture state
        return stop(state.server)
      finally
        capture fs
        capture files
        fs/rmSync(files.dir, {
            recursive: true
            force: true
        })
