import "../widgets"
    progressRange(min, max, value = null)

test "progress ranges clamp finite values and preserve an indeterminate state"
    empty = progressRange(0, 100)
    assert empty.value == null
    assert empty.percent == null
    zero = progressRange(-10, 10, 0)
    assert zero.value == 0
    assert zero.percent == 50
    low = progressRange(20, 40, -1)
    assert low.value == 20
    assert low.percent == 0
    high = progressRange(20, 40, 100)
    assert high.value == 40
    assert high.percent == 100

test "progress rejects invalid ranges and nonnumeric values before updating a view"
    for [[0, 0, 0], [10, 1, 5], [null, 100, 1], [0, "100", 1], [0, 100, "10"]] as values
        failed = false
        try
            progressRange(values[0], values[1], values[2])
        catch error
            failed = true
        assert failed

import "../tables"
    spanValue(value)
import "../navigation"
    navigationMatch(url, current)

test "table spans accept positive bounded integers only"
    assert spanValue(null) == 1
    assert spanValue(3) == 3
    for [0, -1, 1.5, "2", 1001] as value
        failed = false
        try
            spanValue(value)
        catch error
            failed = true
        assert failed

test "navigation follows path segments and never activates external links"
    assert navigationMatch("/admin", "https://app.test/admin/users") == 6
    assert navigationMatch("/admin/", "https://app.test/admin/users") == 7
    assert navigationMatch("/admin", "https://app.test/administrator") == -1
    assert navigationMatch("/", "https://app.test/admin") == -1
    assert navigationMatch("https://other.test/admin", "https://app.test/admin") == -1
    assert navigationMatch("/admin/users", "https://app.test/admin/users?sort=name") == 12

import "../collections"
    listIndex(value, length)

test "list active indices are bounded and do not imply a selected value"
    assert listIndex(null, 0) == -1
    assert listIndex(-1, 3) == -1
    assert listIndex(1, 3) == 1
    for [0, 1.5, "0", -2] as value
        failed = false
        try
            listIndex(value, 0)
        catch error
            failed = true
        assert failed

import "../markdown"
    escapeHtml(text)

test "Markdown raw HTML escaping preserves literal markup and entities"
    assert escapeHtml("<b>Text & more</b>") == "&lt;b&gt;Text &amp; more&lt;/b&gt;"
    assert escapeHtml("&lt;") == "&amp;lt;"
