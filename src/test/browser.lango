        capture playwright
        return playwright/chromium/launch({
            headless: true
        })
      then(instance)
        capture state
        state.browser = instance
        return state.browser.newPage()
      then(page)
        capture state
        capture server
        capture errorHandler
        state.page = page
        page.on("pageerror", errorHandler)
        page.setDefaultTimeout(10000)
        return state.page.goto("http://127.0.0.1:${server.address().port}/forms")
      then(ignored)
        capture state
        global requests
        return chain exerciseForms(state.page, requests)
          catch(error)
            capture state
            return chain state.page.locator("#app").innerText()
