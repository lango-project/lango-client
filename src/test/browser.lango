test "authentication changes notify another tab without replacing its values or replaying its actions"
    resetLogin()
    server = http/createServer(loginServer)
    state = {}
    pending = new Promise((resolve, reject)
        capture server
        server.once("error", reject)
        server.listen(0, "127.0.0.1", resolve)
    )
    return chain pending
      then(ignored)
        capture playwright
        return playwright/chromium/launch({
            headless: true
        })
      then(browser)
        capture state
        Object/assign(state, {
            browser: browser
        })
        return browser.newContext()
      then(scope)
        capture state
        Object/assign(state, {
            browserContext: scope
        })
        return scope.newPage()
      then(page)
        capture server
        capture state
        Object/assign(state, {
            first: page
        })
        return page.goto("http://127.0.0.1:${server.address().port}/login-demo")
      then(ignored)
        capture state
        return state.first.getByRole("button", {
            name: "Protected save"
        }).waitFor()
      then(ignored)
        capture state
        return state.browserContext.newPage()
      then(page)
        capture server
        capture state
        Object/assign(state, {
            second: page
        })
        return page.goto("http://127.0.0.1:${server.address().port}/login-demo")
      then(ignored)
        capture state
        return exerciseLoginTabs(state.first, state.second)
      finally
        capture server
        capture state
        server.closeAllConnections()
        server.close()
        if state.browser != null
            return state.browser.close()
