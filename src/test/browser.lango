        server.close()
        if state.browser != null
            return state.browser.close()

test "browser resources cancel held HTTP polls and report only bounded technical details"
    resetResources()
    server = http/createServer(resourceServer)
    pending = new Promise((resolve, reject)
        capture server
        server.once("error", reject)
        server.listen(0, "127.0.0.1", resolve)
    )
    state = {}
    errorHandler = browserError
    return chain pending
      then(ignored)
        capture playwright
        return playwright/chromium/launch({
            headless: true
        })
      then(instance)
        capture state
        state.browser = instance
        return state.browser.newPage()
      then(page)
        capture state
        capture server
        capture errorHandler
        state.page = page
        page.setDefaultTimeout(10000)
        page.on("pageerror", errorHandler)
        return state.page.goto("http://127.0.0.1:${server.address().port}/resources")
      then(ignored)
        capture state
        return exerciseResources(state.page)
      finally
        capture server
        capture state
        server.closeAllConnections()
        server.close()
        if state.browser != null
            return state.browser.close()

