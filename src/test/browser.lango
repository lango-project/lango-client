test "tables render data, isolate row templates, collect values and clean replaced scopes"
    server = http/createServer(serve)
    state = {}
    errorHandler = browserError
    pending = new Promise((resolve, reject)
        capture server
        server.once("error", reject)
        server.listen(0, "127.0.0.1", resolve)
    )
    return chain pending
      then(ignored)
        capture playwright
        return playwright/chromium/launch({
            headless: true
        })
      then(browser)
        capture state
        Object/assign(state, {
            browser: browser
        })
        return browser.newPage()
      then(page)
        capture errorHandler
        capture state
        capture server
        Object/assign(state, {
            page: page
        })
        page.on("pageerror", errorHandler)
        return page.goto("http://127.0.0.1:${server.address().port}/table-test")
      then(ignored)
        capture state
        return state.page.addScriptTag({
            type: "module"
            url: "/test-table/main.mjs"
        })
      then(ignored)
        capture state
        return state.page.waitForFunction("document.body.hasAttribute('data-table-result')")
      then(ignored)
        capture state
        return state.page.locator("body").getAttribute("data-table-result")
      then(result)
        capture state
        if result != "passed"
            return chain state.page.locator("body").textContent()
              then(message)
                throw message
      finally
        capture state
        capture server
        server.close()
        if state.browser != null
            return state.browser.close()


