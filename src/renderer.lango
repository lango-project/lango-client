import "./dimensions"
    applyDimensions(element, props)
    applyLayout(element, props)
import js global Object
import js global document
import js global Reflect
import "./templates"
    createTemplate(xml)
    cloneTemplate(template)
import "./button"
    class Button
import "./control"
    class Control
    class Value
import "./fields"
    class Input
    class Checkbox
    class Switch
    class Range
    class Select
    class Radio
import "./form"
    class Form
import "./widgets"
    class Alert
    class Progress
import "./presentations"
    class Presentations
    class Toast
    class ToastStack
import "./layouts"
    class Card
    class CardGroup
    class Image
    class Badge
    class Toolbar
import "./tabs"
    class Tab
import "./tables"
    class Table
import "./navigation"
    class Nav
    class NavBar
    class Breadcrumb

import "./collections"
    class ListGroup
import "./menus"
    class Menu
import "./accordion"
    class Accordion
import "./input_group"
    class InputGroup
import "./markdown"
    class Markdown

import "./chip"
    class Chip
import "./combo_box"
    class ComboBox
import "./indicators"
    class Avatar
    class FormSpinner

import "./otp_input"
    class OTPInput
import "./file_input"
    class FileInput
import "./numeric_input"
    class NumericInput
import "./date_input"
    class DateInput

export class BootstrapRenderer()
    properties
        presentations
        navigation
    methods
        sessionChanged(form)
        openLogin(form, cancel)
        registerControlType(name, factory)
        build(form, props)
        show(form, view)
        waiting(form, active)
        reportError(form, error)
        locationChanged(url)

BootstrapRenderer()
    @factories = Object/create(null)
    @navigation = []
    @presentations = new Presentations(@this)
    @templates = Object/create(null)
    @templates.text = createTemplate(<span></span>)
    @templates.value = createTemplate(<span hidden="hidden"></span>)
    @templates.frame = createTemplate(<div></div>)
    @fields = {
        input: Input
        checkbox: Checkbox
        "switch": Switch
        range: Range
        select: Select
        radio: Radio
        progress: Progress
        badge: Badge
        markdown: Markdown
        formSpinner: FormSpinner
    }
    @inputs = {
        otp: OTPInput
        file: FileInput
        date: DateInput
    }
    @layouts = {
        button: Button
        alert: Alert
        card: Card
        cardGroup: CardGroup
        image: Image
        toolbar: Toolbar
        tab: Tab
        table: Table
        nav: Nav
        navBar: NavBar
        breadcrumb: Breadcrumb
        listGroup: ListGroup
        menu: Menu
        accordion: Accordion
        inputGroup: InputGroup
        avatar: Avatar
        chip: Chip
        comboBox: ComboBox
    }

BootstrapRenderer:registerControlType(name, factory)
    if name in @factories
        throw "Control type already registered: ${name}"
    @factories[name] = factory
    return @this

BootstrapRenderer:build(form, props)
    if !is_object(props) or !is_string(props.type)
        throw "Control requires a type"
    if props.type == "form"
        child = new Form(form.app, form, form.token)
        child.inheritedNames = props.inheritedNames
        if child.inheritedNames == null
            child.inheritedNames = []
        form.register(props.name, child)
        child.element = cloneTemplate(@templates.frame)
        child.spinner = props.spinner
        for props.controls as item
            child.element.appendChild(build(child, item))
        resolveSpinner(child)
        applyDimensions(child.element, props)
        return child.element
    if props.type in @factories
        custom = @factories[props.type](form, props)
        form.register(props.name, custom)
        return custom.element
    if props.type == "toast"
        toast = new Toast(form, props, @this)
        form.register(props.name, toast)
        return toast.element
    if props.type == "toastStack"
        stack = new ToastStack(form, props, @this)
        form.register(props.name, stack)
        return stack.element
    if props.type in @fields or props.type in @layouts
        ctor = null
        field = null
        if props.type in @layouts
            ctor = @layouts[props.type]
            field = Reflect/construct(ctor, [form, props, @this])
          else
              ctor = @fields[props.type]
              if props.type == "input" and is_string(props.variant)
                  variant = props.variant.toLowerCase()
                  if variant in @inputs
                      ctor = @inputs[variant]
                    else
                        if props.format != null and (variant == "number" or variant == "decimal" or variant == "money")
                            ctor = NumericInput
              field = Reflect/construct(ctor, [form, props])
        form.register(props.name, field)
        if props.style != null
            for props.style as name: value
                field.element.style.setProperty(name, value)
        if props.aria != null
            for props.aria as name: value
                field.element.setAttribute("aria-${name}", value)
        return field.element
    kind = props.type
    template = null
    if kind == "row" or kind == "col" or kind == "container"
        template = @templates.frame
      else
          if !(kind in @templates) or kind == "frame"
              throw "Unsupported control type: ${props.type}"
          template = @templates[kind]
    element = cloneTemplate(template)
    applyLayout(element, props)
    control = null
    if kind == "value"
        control = new Value(form, props, element)
      else
          control = new Control(form, props, element)
    form.register(props.name, control)
    if props.style != null
        for props.style as name: value
            element.style.setProperty(name, value)
    if props.aria != null
        for props.aria as name: value
            element.setAttribute("aria-${name}", value)
    switch kind
      case "text"
          element.textContent = props.text
      case "container"
      case "row"
      case "col"
          if props.controls != null
              for props.controls as item
                  element.appendChild(build(form, item))
    return element

BootstrapRenderer:show(form, view)
    previous = form.controls
    owned = form.owned
    inherited = form.inheritedNames
    spinner = form.spinner
    form.controls = Object/create(null)
    form.owned = []
    content = document/createElement("div")
    try
        form.spinner = null
        if view.type == "form"
            form.spinner = view.spinner
            form.inheritedNames = view.inheritedNames
            if form.inheritedNames == null
                form.inheritedNames = []
            for view.controls as props
                content.appendChild(build(form, props))
          else
              content.appendChild(build(form, view))
        resolveSpinner(form)
        form.element.replaceChildren(content)
    catch error
        for form.owned.slice() as control
            control.dispose()
        form.controls = previous
        form.owned = owned
        form.inheritedNames = inherited
        form.spinner = spinner
        throw error
    for owned as control
        control.dispose()
    form.clearResources()
    if form.waiting
        waiting(form, true)
    return null

BootstrapRenderer:resolveSpinner(form)
    value = form.spinner
    if value == null
        return null
    if is_string(value)
        value = form.find(value)
      else
          if is_object(value) and value.type == "formSpinner"
              definition = value
              value = new FormSpinner(form, definition)
              form.register(definition.name, value)
    if !is_kindof(value, FormSpinner) or value.form != form
        throw "Form.spinner requires a FormSpinner belonging to this form"
    form.spinner = value
    return null

BootstrapRenderer:waiting(form, active)
    form.waiting = active
    if form.spinner != null
        form.spinner.show(active)
    if form.element != null
        form.element.classList.toggle("lango-waiting", active)
        form.element.classList.toggle("lango-custom-spinner", active and form.spinner != null)
        form.element.setAttribute("aria-busy", "${active}")
    return null

BootstrapRenderer:reportError(form, error)
    element = document/createElement("div")
    element.className = "toast show text-bg-danger"
    element.setAttribute("role", "alert")
    element.textContent = "${error}"
    form.element.appendChild(element)
    return null

BootstrapRenderer:locationChanged(url)
    for @navigation as group
        group.locationChanged(url)
    return null

BootstrapRenderer:openLogin(form, cancel)
    modal = document/createElement("dialog")
    modal.className = "lango-login modal-content p-3"
    modal.setAttribute("aria-label", "Sign in")
    modal.style.maxWidth = "min(36rem, 95vw)"
    close = document/createElement("button")
    close.type = "button"
    close.className = "btn-close align-self-end"
    close.setAttribute("aria-label", "Cancel sign in")
    body = document/createElement("div")
    form.element = body
    modal.appendChild(close)
    modal.appendChild(body)
    click = ()
        capture cancel
        cancel()
    escape = (event)
        capture cancel
        event.preventDefault()
        cancel()
    close.addEventListener("click", click)
    modal.addEventListener("cancel", escape)
    document/body/appendChild(modal)
    modal.showModal()
    return ()
        capture modal
        capture close
        capture click
        capture escape
        close.removeEventListener("click", click)
        modal.removeEventListener("cancel", escape)
        modal.close()
        modal.remove()

BootstrapRenderer:sessionChanged(form)
    waiting(form, false)
    if form.element == null
        return null
    alert = document/createElement("div")
    alert.className = "alert alert-warning lango-session-changed"
    alert.setAttribute("role", "alert")
    alert.textContent = "Your sign-in state changed. Reload the page to continue. Your current input is still visible. "
    button = document/createElement("button")
    button.type = "button"
    button.className = "btn btn-outline-dark btn-sm"
    button.textContent = "Reload page"
    click = ()
        capture form
        form.app.reloadSession()
    button.addEventListener("click", click)
    alert.appendChild(button)
    form.element.prepend(alert)
    release = ()
        capture button
        capture click
        button.removeEventListener("click", click)
    form.resources.add(release)
    return null
