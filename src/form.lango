import js global Object
import js global Reflect
import js global Promise
import "./activities"
    class Activities

export class Form(app, parent = null, token = null)
    properties
        app
        parent
        token
        controls
        owned
        inheritedNames
        disposed
        stale
        element
        resources
        activity
        presentation
        inheritThrough
        spinner
        waiting
    methods
        register(name, control)
        unregister(control)
        find(name)
        inherited(name)
        getValue()
        prepareValue()
        setValue(values)
        setToken(token)
        send(url)
        handle(packet)
        related(other)
        clearValidation()
        clearResources()
        dispose()

Form(app, parent = null, token = null)
    @app = app
    @parent = parent
    @token = token
    @controls = Object/create(null)
    @owned = []
    @inheritedNames = []
    @disposed = false
    @stale = false
    @element = null
    @resources = []
    @activity = new Activities(@this)
    @presentation = null
    @inheritThrough = false
    @spinner = null
    @waiting = false
    app.forms.add(@this)

Form:register(name, control)
    @owned.add(control)
    if name == null
        return control
    if !is_string(name) or name == "" or name.includes("/") or name in @controls
        throw "Invalid or duplicate control name: ${name}"
    @controls[name] = control
    return control

Form:unregister(control)
    for Object/keys(@controls) as name
        if @controls[name] == control
            Reflect/deleteProperty(@controls, name)
    index = @owned.indexOf(control)
    if index >= 0
        @owned.splice(index, 1)
    return null

Form:find(name)
    parts = name.split("/")
    current = @controls[parts.shift()]
    if current == null
        if @inheritedNames.includes(name) and @parent != null
            return inherited(name)
        throw "Unknown control: ${name}"
    if parts.length > 0
        if current.find == null
            throw "Control has no named children: ${name}"
        return current.find(parts.join("/"))
    return current

Form:inherited(name)
    parent = @parent
    loop while parent != null and parent.inheritThrough
        parent = parent.parent
    if parent == null
        throw "Inherited value has no parent: ${name}"
    return parent.find(name)

Form:getValue()
    result = Object/create(null)
    for @controls as name: control
        result[name] = control.getValue()
    for @inheritedNames as name
        if @parent == null or name in result
            throw "Invalid inherited name: ${name}"
        source = inherited(name)
        result[name] = source.getValue()
    return result

Form:prepareValue()
    pending = []
    for @owned as control
        if control.prepareValue != null
            ready = control.prepareValue()
            if ready != null
                pending.add(ready)
    for @inheritedNames as name
        source = inherited(name)
        if source.prepareValue != null
            inheritedReady = source.prepareValue()
            if inheritedReady != null
                pending.add(inheritedReady)
    if pending.length == 0
        return null
    return Promise/all(pending)

Form:setValue(values)
    for values as name: value
        find(name).setValue(value)
    return @this

Form:clearValidation()
    for @controls as name: control
        if control.clearValidation != null
            control.clearValidation()
    for @inheritedNames as name
        source = find(name)
        if source.clearValidation != null
            source.clearValidation()
    return null

Form:clearResources()
    @activity.clear()
    resources = @resources
    @resources = []
    for resources as release
        release()
    return null

Form:setToken(token)
    if token != null
        if @app.saveToken(token) == false
            return @this
        @token = token
        if @app.heartbeat != null
            @app.heartbeat.observe(token)
    return @this

Form:send(url)
    return @app.send(@this, url)

Form:handle(packet)
    if @disposed or @stale
        return null
    previous = @token
    @app.beginLoginResponse(@this, packet)
    setToken(packet.token)
    if @stale
        return null
    body = packet.body
    if body.view != null
        @app.renderer.show(@this, body.view)
    if body.cmds != null
        for body.cmds as cmd
            @app.command(@this, cmd)
    @app.completeLogin(@this)
    @app.observeAuthentication(@this, previous, packet)
    return null

Form:related(other)
    node = other
    loop while node != null
        if node == @this
            return true
        node = node.parent
    node = @this
    loop while node != null
        if node == other
            return true
        node = node.parent
    return false

Form:dispose()
    if @disposed
        return null
    @disposed = true
    @app.loginScopeDisposed(@this)
    for @owned.slice() as control
        control.dispose()
    clearResources()
    @controls = Object/create(null)
    alive = []
    for @app.forms as form
        if form != @this
            alive.add(form)
    @app.forms = alive
    return null
