import js global Error
import js global Object
import js global Promise
import js global URL
import js global Date
import "./form"
    class Form
import "./heartbeat"
    class Heartbeat
import "./error_reporter"
    class ErrorReporter

export class App(host, renderer)
    properties
        forms
        root
        renderer
        heartbeat
        resources
        reporter
    methods
        start()
        post(url, input, token)
        saveToken(token)
        clearSavedToken()
        send(form, url, owner = null)
        deliver(form, action, owner, generation)
        report(form, url, input, owner)
        executeDelivery(job)
        checkUrl(url)
        hostUrl()
        request(url, input, token, signal = null, channel = false, opening = false)
        poll(url, input, token, signal)
        canPoll(form)
        pausePolls(form = null)
        resumePolls()
        schedule(action, delay)
        cancelTimer(timer)
        now()
        error(form, error, code = "UiFailure", name = null)
        drain()
        execute(job)
        navigate(url, push = true)
        selectTemplate(path)
        ping()
        executePing(job)
        command(form, cmd)
        dispose()

App(host, renderer)
    @host = host
    @renderer = renderer
    @forms = []
    @queue = []
    @active = []
    @disposed = false
    @root = null
    @events = {}
    @template = null
    @heartbeat = null
    @pingJob = null
    @resources = []
    @reporter = null

App:now()
    if @host.now != null
        return @host.now()
    return Date/now()

App:hostUrl()
    return @host.location.href

App:schedule(action, delay)
    return @host.schedule(action, delay)

App:cancelTimer(timer)
    @host.cancelTimer(timer)
    return null

App:checkUrl(url)
    if !is_string(url) or url.trim() == ""
        throw "UI request requires a URL"
    target = new URL(url, @host.location.href)
    if target.origin != @host.location.origin
        throw "UI requests must use the current origin"
    return target

App:error(form, error, code = "UiFailure", name = null)
    if form != null and form.requestForm != null
        form = form.requestForm
    if @disposed or form == null or form.disposed
        return null
    @renderer.reportError(form, error)
    if @reporter != null
        @reporter.capture("ui", code, name, form)
    return null

App:saveToken(token)
    try
        @host.storage.setItem("lango.token", token)
    catch error
        return null
    return null

App:clearSavedToken()
    try
        @host.storage.removeItem("lango.token")
        return true
    catch error
        return false

App:post(url, input, token)
    return request(url, input, token)

App:poll(url, input, token, signal)
    return request(url, input, token, signal, true)

App:request(url, input, token, signal = null, channel = false, opening = false)
    target = checkUrl(url)
    headers = {
        "Content-Type": "application/json"
    }
    headers["X-Lango-Screen"] = "wide"
    if @host.screen != null
        headers["X-Lango-Screen"] = @host.screen()
    if token != null
        headers.Authorization = "Bearer ${token}"
    options = {
        method: "POST"
        headers: headers
        body: to_json(input)
    }
    if signal != null
        options.signal = signal
    return chain @host.fetch("${target.pathname}${target.search}", options)
      then(res)
        capture channel
        capture opening
        capture token
        if !res.ok
            if opening and res.status == 401 and token != null
                if clearSavedToken()
                    throw new Error("Startup HTTP 401: saved token was rejected and cleared. Reload the page to start a new session.")
                throw new Error("Startup HTTP 401: saved token was rejected but storage could not be cleared. Clear this site's local storage and reload.")
            if !channel
                throw "HTTP ${res.status}"
            if res.status != 409
                return {
                    status: res.status
                    retryAfter: res.headers.get("retry-after")
                }
        return chain res.json()
          then(body)
            capture res
            capture channel
            if !is_object(body) or is_array(body)
                if channel
                    throw {
                        code: "InvalidPollResponse"
                    }
                throw "UI response must be a map"
            status = res.status
            if status == null
                status = 200
            return {
                status: status
                token: res.headers.get("x-lango-token")
                body: body
            }
          catch(error)
            capture channel
            if channel
                throw {
                    code: "InvalidPollResponse"
                }
            throw error

App:start()
    token = null
    try
        token = @host.storage.getItem("lango.token")
    catch error
        token = null
    return chain request("/", {}, token, null, false, true)
      then(packet)
        @events = packet.body
        if @events.clientErrorUrl != null
            @reporter = new ErrorReporter(@this, @events.clientErrorUrl)
        if @events.pingUrl != null
            @heartbeat = new Heartbeat(@this, @host, @events.pingUrl)
        @root = new Form(@this, null, packet.token)
        @root.element = @host.mount
        @root.setToken(packet.token)
        return chain navigate(@host.location.pathname, false)
          then(ignored)
            if @heartbeat != null
                @heartbeat.start()
            return null

App:send(form, url, owner = null)
    if @disposed or form.disposed
        return Promise/reject("Form is disposed")
    pending = new Promise((resolve, reject)
        capture form
        capture url
        capture owner
        @queue.add({
            kind: "send"
            form: form
            url: url
            owner: owner
            resolve: resolve
            reject: reject
        })
        drain()
    )
    return pending

App:deliver(form, action, owner, generation)
    if @disposed or form.disposed or !owner.active
        return Promise/resolve(null)
    deferred = Promise/withResolvers()
    @queue.add({
        kind: "delivery"
        form: form
        action: action
        owner: owner
        generation: generation
        resolve: deferred.resolve
        reject: deferred.reject
    })
    drain()
    return deferred.promise

App:report(form, url, input, owner)
    if @disposed or form.disposed or !owner.active
        return Promise/resolve(null)
    deferred = Promise/withResolvers()
    @queue.add({
        kind: "report"
        form: form
        url: url
        input: input
        owner: owner
        resolve: deferred.resolve
        reject: deferred.reject
    })
    drain()
    return deferred.promise

App:canPoll(form)
    if @disposed or form.disposed or @pingJob != null
        return false
    for @active as job
        if form.related(job.form)
            return false
    for @queue as job
        if form.related(job.form)
            return false
    return true

App:pausePolls(form = null)
    for @forms.slice() as candidate
        if form == null or form.related(candidate)
            candidate.activity.pause()
    return null

App:resumePolls()
    for @forms.slice() as form
        form.activity.resume()
    return null

App:drain()
    if @pingJob != null
        if @active.length == 0 and !@pingJob.running
            @pingJob.running = true
            executePing(@pingJob)
        return null
    for @queue.slice() as job
        blocked = false
        for @active as running
            if job.form.related(running.form)
                blocked = true
        for @queue as earlier
            if earlier == job
                break
            if job.form.related(earlier.form)
                blocked = true
        if !blocked
            @queue.splice(@queue.indexOf(job), 1)
            @active.add(job)
            if job.kind == "delivery"
                executeDelivery(job)
              else
                  pausePolls(job.form)
                  execute(job)
    resumePolls()
    return null

App:executeDelivery(job)
    return chain Promise/resolve(null)
      then(ignored)
        capture job
        if !job.form.disposed and job.owner.active and job.owner.generation == job.generation
            action = job.action
            action()
        job.resolve(null)
      catch(error)
        capture job
        job.reject(error)
      finally
        capture job
        @active.splice(@active.indexOf(job), 1)
        drain()

App:ping()
    if @disposed or @heartbeat == null
        return Promise/resolve(null)
    if @pingJob != null
        return @pingJob.promise
    deferred = Promise/withResolvers()
    @pingJob = {
        promise: deferred.promise
        resolve: deferred.resolve
        reject: deferred.reject
        running: false
    }
    pausePolls()
    drain()
    return deferred.promise

App:executePing(job)
    return chain Promise/resolve(null)
      then(ignored)
        return @heartbeat.exchange()
      then(ignored)
        capture job
        job.resolve(null)
      catch(error)
        capture job
        job.reject(error)
      finally
        @pingJob = null
        drain()

App:execute(job)
    form = job.form
    return chain Promise/resolve(null)
      then(ignored)
        capture form
        capture job
        if form.disposed
            throw "Form is disposed"
        if job.owner != null and !job.owner.active
            return null
        if job.kind == "report"
            return post(job.url, job.input, form.token)
        form.clearValidation()
        @renderer.waiting(form, true)
        ready = form.prepareValue()
        if ready == null
            return post(job.url, form.getValue(), form.token)
        return chain ready
          then(ignored)
            capture form
            capture job
            if form.disposed
                throw "Form is disposed"
            if job.owner != null and !job.owner.active
                return null
            return post(job.url, form.getValue(), form.token)
      then(packet)
        capture form
        capture job
        if packet != null and !form.disposed and (job.owner == null or job.owner.active)
            if job.kind == "report"
                form.setToken(packet.token)
              else
                  form.handle(packet)
      then(ignored)
        capture job
        job.resolve(null)
      catch(error)
        capture job
        job.reject(error)
      finally
        capture job
        capture form
        if job.kind == "send"
            @renderer.waiting(form, false)
        @active.splice(@active.indexOf(job), 1)
        drain()

App:navigate(url, push = true)
    target = new URL(url, @host.location.href)
    if target.origin != @host.location.origin
        throw "UI navigation must use the current origin"
    path = target.pathname
    if path == "/"
        path = "/index"
    template = selectTemplate(path)
    ready = Promise/resolve(null)
    if template != @template
        if template != null
            ready = @root.send(template)
          else
              @template = null
    return chain ready
      then(ignored)
        capture template
        capture path
        capture Form
        @template = template
        form = @root
        if template != null
            form = @root.find("__content__")
            if !is_kindof(form, Form)
                throw "Template requires a __content__ form"
        return form.send(path)
      then(ignored)
        capture target
        capture push
        if push
            @host.history.pushState(null, "", "${target.pathname}${target.search}${target.hash}")
        if @renderer.locationChanged != null
            @renderer.locationChanged(target.href)
        return null

App:selectTemplate(path)
    urls = @events.templates
    if urls == null
        urls = []
    selected = @events.defaultTemplate
    if path == selected
        throw "Template URLs cannot be used as page URLs"
    best = 0
    for urls as url
        if !is_string(url) or !url.startsWith("/") or url == "/" or url.endsWith("/")
            throw "Invalid template URL"
        if path == url
            throw "Template URLs cannot be used as page URLs"
        if path == url or path.startsWith("${url}/")
            if url.length > best
                selected = url
                best = url.length
    if path == selected
        throw "Template URLs cannot be used as page URLs"
    return selected

App:command(form, cmd)
    switch cmd.type
      case "values"
          form.setValue(cmd.values)
      case "addRow"
          form.find(cmd.name).addRow(cmd.value)
      case "insertRow"
          form.find(cmd.name).insertRow(cmd.beforeIndex, cmd.value)
      case "deleteRow"
          form.find(cmd.name).deleteRow(cmd.index)
      case "setRowValue"
          form.find(cmd.name).setRowValue(cmd.index, cmd.value)
      case "setRowData"
          form.find(cmd.name).setRowData(cmd.index, cmd.value)
      case "setCellValue"
          form.find(cmd.name).setCellValue(cmd.index, cmd.column, cmd.value)
      case "invalid"
          form.find(cmd.name).setInvalid(cmd.message)
      case "set"
          targetForm = form.find(cmd.name)
          if !is_kindof(targetForm, Form)
              throw "Set requires a form target"
          @renderer.show(targetForm, cmd.control)
      case "setUrl"
          target = new URL(cmd.url, @host.location.href)
          if target.origin != @host.location.origin
              throw "UI URL must use the current origin"
          @host.history.pushState(null, "", "${target.pathname}${target.search}${target.hash}")
          if @renderer.locationChanged != null
              @renderer.locationChanged(target.href)
      case "redirect"
          action = ()
              capture cmd
              chain navigate(cmd.url)
                catch(problem)
                  capture form
                  error(form, problem)
          @host.defer(action)
      case "disable"
          form.find(cmd.name).setDisabled(true)
      case "enable"
          form.find(cmd.name).setDisabled(false)
      case "changeCaption"
          form.find(cmd.name).setCaption(cmd.caption)
      case "activateTabItem"
          form.find(cmd.name).activate()
      case "setProgress"
          form.find(cmd.name).setRange(cmd.min, cmd.max, cmd.value)
      case "updateProgress"
          form.find(cmd.name).update(cmd.value, cmd.label)
      case "showAlert"
          @renderer.presentations.showAlert(form, cmd)
      case "dismissAlert"
          @renderer.presentations.dismissAlert(form, cmd.name)
      case "showToast"
          @renderer.presentations.showToast(form, cmd.toast, cmd.stack)
      case "showDialog"
          @renderer.presentations.showDialog(form, cmd.dialog, cmd.keepPrev)
      case "swapDialog"
          @renderer.presentations.swapDialog(form)
      case "setTimer"
          form.activity.timer(cmd.url, cmd.interval)
      case "clearTimer"
          form.activity.clearTimer(cmd.url)
      case "setInterval"
          form.activity.timer(cmd.url, cmd.interval, true)
      case "clearInterval"
          form.activity.clearTimer(cmd.url, true)
      case "startLongPoll"
          form.activity.startLongPoll(cmd.url, cmd.key, cmd.cursor)
      case "stopLongPoll"
          form.activity.stopLongPoll(cmd.url, cmd.key)
      else
          throw "Unsupported UI command: ${cmd.type}"
    return null

App:dispose()
    @disposed = true
    if @heartbeat != null
        @heartbeat.dispose()
    if @reporter != null
        @reporter.dispose()
    for @forms.slice() as form
        form.dispose()
    for @queue as job
        job.reject("Application is disposed")
    @queue = []
    for @resources as release
        release()
    @resources = []
    return null
